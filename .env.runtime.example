# Только compose.runtime.yml; абсолютные существующие пути, без секретов.
# Скопируйте вне Git. Пустые обязательные images/name отклоняются Compose.
COMPOSE_PROJECT_NAME=
PL_IMAGE=
GATEWAY_IMAGE=
NGINX_IMAGE=
DEPLOY_ROOT=/srv/prairielearn
PL_CONFIG_FILE=/srv/prairielearn/private/pl/pl.json
BRIDGE_CONFIG_DIR=/srv/prairielearn/private/pl
GATEWAY_CONFIG_DIR=/srv/prairielearn/private/gateway
NGINX_CONFIG=/srv/prairielearn/configuration/nginx.conf
PROXY_PRIVATE=/srv/prairielearn/private/proxy
TLS_DIR=/srv/prairielearn/tls
PL_CA_FILE=/srv/prairielearn/tls/ca.crt
# Прежняя публичная TLS identity, например DNS hostname или IPv4 без :443.
PL_TLS_NAME=
# Loopback по умолчанию; LAN ingress на новой VM включают явно после проверки.
BIND_IP=127.0.0.1
